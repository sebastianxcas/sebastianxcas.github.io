---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import Section from '@/components/ui/Section.astro';
import siteConfig from '@/site.config';
import { withBase } from '@/lib/url';
---

<BaseLayout
  title="Presentación"
  description="Presentación de Sebastián Castellanos para la asignatura Bases de Datos 1."
>
  <Header />

  <main id="main" tabindex="-1">

    <!-- ===== SECCIÓN HERO (PRESENTACIÓN PRINCIPAL) ===== -->
    <section class="about-hero">
      <Container size="xl">
        <GlassPanel
          variant="solid"
          padding="xl"
          radius="xl"
          className="about-hero__panel"
        >
          <div class="about-hero__meta">
            <span>Presentación</span>
            <span>Bases de Datos 1 · Universidad El Bosque</span>
          </div>

          <div class="about-hero__body">
            <!-- Foto -->
            <div class="about-photo">
              <img
                src="/sebastian.jpg"
                alt="Sebastián Castellanos"
              />
            </div>

            <!-- Título y descripción -->
            <div class="about-hero__content">
              <span class="about-hero__greeting">HOLA, SOY SEBASTIÁN.</span>
              <h1>También puedes llamarme Sebas.</h1>
              <div class="about-hero__statement">
                <p>
                  Soy estudiante de Ingeniería de Sistemas y este es mi
                  e-portafolio para la asignatura Bases de Datos 1.
                </p>
                <p>
                  En mi tiempo libre me gusta jugar videojuegos,
                  especialmente Valorant, y escuchar música. No tengo un
                  género musical específico; simplemente disfruto escuchar
                  música que me guste.
                </p>
              </div>
            </div>
          </div>

          <div class="about-hero__footer">
            <span aria-hidden="true">SC / 01</span>
            <div class="about-hero__actions">
              <Button
                href={siteConfig.social.github}
                external
                variant="solid"
                size="lg"
              >
                Mi GitHub <span aria-hidden="true">↗</span>
              </Button>
            </div>
          </div>
        </GlassPanel>
      </Container>
    </section>

    <!-- ===== SECCIÓN: ¿POR QUÉ BD1 ME AYUDARÁ? ===== -->
    <Section
      eyebrow="Bases de Datos 1"
      title="¿Por qué creo que esta materia me ayudará?"
      subtitle="Una parte importante de mi formación como ingeniero de sistemas."
      align="left"
      container="xl"
    >
      <div class="about-hero__statement">
        <p>
          Considero que es fundamental para mi vida profesional porque me enseña el lenguaje universal de los negocios: los datos.
          No solo voy a aprender a usar un motor de base de datos, sino a diseñar estructuras lógicas y eficientes que eviten redundancias y errores.
        </p>
        <p>
          Los conocimientos adquiridos en Bases de Datos 1 podrán ayudarme
          en los proyectos que desarrolle durante mi carrera y posteriormente
          en mi vida profesional.
        </p>
      </div>
    </Section>

    <!-- ===== SECCIÓN: VIDEO DE PRESENTACIÓN ===== -->
    <Section
      eyebrow="Mi presentación"
      title="Conoce un poco más sobre mí."
      subtitle="Video de presentación para Bases de Datos 1."
      align="left"
      container="xl"
    >
      <GlassPanel
        variant="solid"
        padding="lg"
        radius="xl"
      >
        <div style="aspect-ratio: 16 / 9;">
          <iframe
            src="https://www.youtube.com/embed/Srzb67kSNsI"
            title="Video de presentación de Sebastián Castellanos"
            style="
              width: 100%;
              height: 100%;
              border: 0;
              border-radius: 1rem;
            "
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </GlassPanel>
    </Section>

    <!-- ===== SECCIÓN: OBJETIVO ===== -->
    <section class="principle">
      <Container size="xl">
        <p class="principle__index">Mi objetivo / 03</p>
        <blockquote>
          Este semestre quiero demostrar que...
          <span>puedo mejorar, aprender y aplicar mis conocimientos.</span>
        </blockquote>
        <div class="principle__note">
          <span class="principle__mark" aria-hidden="true">✦</span>
          <p>
            Quiero aprovechar cada actividad, proyecto y evidencia para
            mejorar mis conocimientos en bases de datos y llevarlos a la
            práctica.
          </p>
        </div>
      </Container>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ===== ESTILOS GLOBALES DE LA PÁGINA ===== */
  main {
    overflow: clip;
  }

  .about-hero {
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .about-hero__panel {
    min-height: min(47rem, calc(100vh - 8rem));
    min-height: min(47rem, calc(100dvh - 8rem));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .about-hero__meta,
  .about-hero__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .about-hero__meta {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--glass-border);
  }

  /* ===== CUERPO PRINCIPAL: FOTO + CONTENIDO ===== */
  .about-hero__body {
    display: grid;
    grid-template-columns: minmax(20rem, 1.4fr) minmax(17rem, 0.6fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .about-photo {
    width: 180px;
    height: 180px;
    overflow: hidden;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-hero__greeting {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--text-xs);
    font-weight: 700;
    display: block;
  }

  h1 {
    max-width: 11ch;
    margin: var(--space-lg) 0 0;
    font-size: clamp(3.5rem, 8.5vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  .about-hero__statement {
    padding-left: var(--space-xl);
    border-left: 1px solid var(--glass-border);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .about-hero__statement p:last-child {
    margin-bottom: 0;
  }

  .about-hero__footer {
    align-items: flex-end;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--glass-border);
  }

  .about-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-sm);
  }

  /* ===== SECCIÓN PRINCIPLE (OBJETIVO) ===== */
  .principle {
    padding-block: clamp(7rem, 16vw, 14rem);
  }

  .principle__index {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  blockquote {
    max-width: 15ch;
    margin: clamp(3rem, 7vw, 6rem) 0;
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    font-weight: 750;
    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  blockquote span {
    display: block;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .principle__note {
    display: grid;
    grid-template-columns: auto minmax(15rem, 31rem);
    justify-content: end;
    align-items: start;
    gap: var(--space-lg);
  }

  .principle__note p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .principle__mark {
    color: var(--color-accent);
    font-size: var(--text-2xl);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .about-hero__body {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .about-photo {
      width: 140px;
      height: 140px;
    }
  }

  @media (max-width: 640px) {
    .about-hero__meta,
    .about-hero__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .about-hero__body {
      gap: var(--space-2xl);
    }

    .about-hero__statement {
      padding: var(--space-xl) 0 0;
      border-top: 1px solid var(--glass-border);
      border-left: 0;
    }

    .about-hero__actions {
      justify-content: flex-start;
    }

    .principle__note {
      grid-template-columns: auto 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .format-card:nth-child(2) {
      transform: none;
    }
  }
</style>