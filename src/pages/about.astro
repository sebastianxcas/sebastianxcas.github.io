---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import Section from '@/components/ui/Section.astro';
import siteConfig from '@/site.config';
import { withBase } from '@/lib/url';

const formats = [
  {
    number: '01',
    label: 'Publish',
    title: 'A journal with editorial rhythm.',
    description:
      'Long-form writing, tags, reading metadata, and thoughtful article layouts give ideas enough room to develop.',
    href: '/blog/',
  },
  {
    number: '02',
    label: 'Present',
    title: 'A portfolio that shows the thinking.',
    description:
      'Project collections turn outcomes, process, roles, and technical decisions into clear, navigable case studies.',
    href: '/work/',
  },
  {
    number: '03',
    label: 'Launch',
    title: 'An EC landing page without the lock-in.',
    description:
      'Reusable sections cover benefits, editions, galleries, testimonials, FAQ, and external commerce calls to action.',
    href: '/landing/',
  },
];

const stack = [
  {
    name: 'Astro 7',
    category: 'Framework',
    detail: 'Static-first rendering with a deliberately small browser runtime.',
  },
  {
    name: 'Content Layer',
    category: 'Content',
    detail:
      'Typed, validated collections for articles, projects, and campaign data.',
  },
  {
    name: 'Sätteri',
    category: 'Markdown',
    detail:
      'Astro’s modern Markdown pipeline for dependable authoring and output.',
  },
  {
    name: 'Glass system',
    category: 'Interface',
    detail:
      'Focused translucent surfaces, restrained depth, and solid fallbacks.',
  },
  {
    name: 'Accessible by design',
    category: 'Foundation',
    detail:
      'Semantic structure, visible focus, native controls, and preference-aware motion.',
  },
];
---

<BaseLayout
  title="Presentación"
  description="Presentación de Sebastián Castellanos para la asignatura Bases de Datos 1."
>
  <Header />

  <main id="main" tabindex="-1">

    <section class="about-hero">
      <Container size="xl">
        <GlassPanel
          variant="solid"
          padding="xl"
          radius="xl"
          className="about-hero__panel"
        >
          <div class="about-hero__meta">
            <span>Presentación</span>
            <span>Bases de Datos 1 · Universidad El Bosque</span>
          </div>

          <div class="about-hero__body">
  <div class="about-photo">
    <img
      src="/sebastian.jpeg"
      alt="Sebastián Castellanos"
    />
  </div>

  <div class="about-hero__title">
    <p>Hola, soy Sebastián.</p>
    <h1>También puedes llamarme Sebas.</h1>
  </div>

            <div class="about-hero__statement">
              <p>
                Soy estudiante de Ingeniería de Sistemas y este es mi
                e-portafolio para la asignatura Bases de Datos 1.
              </p>

              <p>
                En mi tiempo libre me gusta jugar videojuegos,
                especialmente Valorant, y escuchar música. No tengo un
                género musical específico; simplemente disfruto escuchar
                música que me guste.
              </p>
            </div>
          </div>

          <div class="about-hero__footer">
            <span aria-hidden="true">SC / 01</span>

            <div class="about-hero__actions">
              <Button
                href={siteConfig.social.github}
                external
                variant="solid"
                size="lg"
              >
                Mi GitHub <span aria-hidden="true">↗</span>
              </Button>
            </div>
          </div>
        </GlassPanel>
      </Container>
    </section>

    <Section
      eyebrow="Bases de Datos 1"
      title="¿Por qué creo que esta materia me ayudará?"
      subtitle="Una parte importante de mi formación como ingeniero de sistemas."
      align="left"
      container="xl"
    >
      <div class="about-hero__statement">
        <p>
          Considero que es fundamental para mi vida profesional porque me enseña el lenguaje universal de los negocios: los datos.
          No solo voy a aprender a usar un motor de base de datos, sino a diseñar estructuras lógicas y eficientes que eviten redundancias y errores.
        </p>

        <p>
          Los conocimientos adquiridos en Bases de Datos 1 podrán ayudarme
          en los proyectos que desarrolle durante mi carrera y posteriormente
          en mi vida profesional.
        </p>
      </div>
    </Section>

    <Section
  eyebrow="Mi presentación"
  title="Conoce un poco más sobre mí."
  subtitle="Video de presentación para Bases de Datos 1."
  align="left"
  container="xl"
>
  <GlassPanel
    variant="solid"
    padding="lg"
    radius="xl"
  >
    <div style="aspect-ratio: 16 / 9;">
      <iframe
        src="https://www.youtube.com/embed/Srzb67kSNsI"
        title="Video de presentación de Sebastián Castellanos"
        style="
          width: 100%;
          height: 100%;
          border: 0;
          border-radius: 1rem;
        "
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </GlassPanel>
</Section>

    <section class="principle">
      <Container size="xl">
        <p class="principle__index">Mi objetivo / 03</p>

        <blockquote>
          Este semestre quiero demostrar que...
          <span>puedo mejorar, aprender y aplicar mis conocimientos.</span>
        </blockquote>

        <div class="principle__note">
          <span class="principle__mark" aria-hidden="true">✦</span>

          <p>
            Quiero aprovechar cada actividad, proyecto y evidencia para
            mejorar mis conocimientos en bases de datos y llevarlos a la
            práctica.
          </p>
        </div>
      </Container>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    overflow: clip;
  }

  .about-hero {
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .about-hero__panel {
    min-height: min(47rem, calc(100vh - 8rem)); /* fallback */
    min-height: min(47rem, calc(100dvh - 8rem));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .about-hero__meta,
  .about-hero__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .about-hero__meta {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--glass-border);
  }

  .about-hero__body {
    display: grid;
    grid-template-columns: minmax(20rem, 1.4fr) minmax(17rem, 0.6fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .about-hero__title > p,
  .about-cta__copy > p {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  h1 {
    max-width: 11ch;
    margin: var(--space-lg) 0 0;
    font-size: clamp(3.5rem, 8.5vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  .about-hero__statement {
    padding-left: var(--space-xl);
    border-left: 1px solid var(--glass-border);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .about-hero__statement p:last-child {
    margin-bottom: 0;
  }

  .about-hero__footer {
    align-items: flex-end;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--glass-border);
  }

  .about-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-sm);
  }

  .format-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .format-card {
    min-height: 28rem;
    display: flex;
    flex-direction: column;
  }

  .format-card:nth-child(2) {
    transform: translateY(2.5rem);
  }

  .format-card__meta {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .format-card h2 {
    max-width: 12ch;
    margin: auto 0 var(--space-lg);
    font-size: var(--text-3xl);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .format-card p {
    color: var(--color-text-muted);
  }

  .format-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--glass-border);
    color: var(--color-text);
    font-weight: 700;
  }

  .format-card__link i {
    color: var(--color-accent);
    font-style: normal;
  }

  .principle {
    padding-block: clamp(7rem, 16vw, 14rem);
  }

  .principle__index {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  blockquote {
    max-width: 15ch;
    margin: clamp(3rem, 7vw, 6rem) 0;
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    font-weight: 750;
    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  blockquote span {
    display: block;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .principle__note {
    display: grid;
    grid-template-columns: auto minmax(15rem, 31rem);
    justify-content: end;
    align-items: start;
    gap: var(--space-lg);
  }

  .principle__note p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .principle__mark {
    color: var(--color-accent);
    font-size: var(--text-2xl);
  }

  .stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--glass-border);
  }

  .stack-list li {
    display: grid;
    grid-template-columns: 3rem 8rem minmax(12rem, 0.65fr) minmax(18rem, 1fr);
    align-items: baseline;
    gap: var(--space-lg);
    margin: 0;
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--glass-border);
  }

  .stack-list__number,
  .stack-list__category {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .stack-list strong {
    font-size: var(--text-xl);
  }

  .stack-list p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .about-cta {
    padding-block: clamp(6rem, 14vw, 12rem);
  }

  .about-cta :global(.container) {
    display: grid;
    grid-template-columns: minmax(20rem, 1.2fr) minmax(18rem, 0.8fr);
    align-items: end;
    gap: clamp(3rem, 10vw, 10rem);
    padding-top: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--glass-border);
  }

  .about-cta h2 {
    max-width: 10ch;
    margin: var(--space-lg) 0 0;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  .about-cta__aside > p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .about-cta__aside > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  @media (max-width: 900px) {
    .about-hero__body,
    .format-list,
    .about-cta :global(.container) {
      grid-template-columns: 1fr;
    }

    .format-card,
    .format-card:nth-child(2) {
      min-height: 22rem;
      transform: none;
    }

    .stack-list li {
      grid-template-columns: 2.5rem 1fr;
    }

    .stack-list strong,
    .stack-list p {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .about-hero__meta,
    .about-hero__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .about-hero__body {
      gap: var(--space-2xl);
    }

    .about-hero__statement {
      padding: var(--space-xl) 0 0;
      border-top: 1px solid var(--glass-border);
      border-left: 0;
    }

    .about-hero__actions {
      justify-content: flex-start;
    }

