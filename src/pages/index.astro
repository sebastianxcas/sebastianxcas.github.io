---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
---

<BaseLayout
  title="Inicio"
  description="Portafolio de Sebastián Castellanos para Bases de Datos 1."
>
  <Header />
  <main id="main" tabindex="-1" class="home">
    <section class="hero">
      <p class="eyebrow">Universidad El Bosque · Ingeniería de Sistemas</p>
      <h1>Bases de <span>Datos 1</span></h1>
      <p class="lead">
        Un recorrido por los conceptos, ejercicios y evidencias que reuní
        durante el semestre.
      </p>
      <p class="signature">E-portafolio de Sebastián Castellanos Parra</p>
      <div class="actions">
        <a class="primary" href="/work/">Explorar evidencias ↗</a><a
          href="/about/">Conocerme →</a>
      </div>
    </section>
    <section class="explore">
      <div class="heading">
        <p class="eyebrow">EL RECORRIDO</p><h2>
          Del concepto a la práctica.
        </h2><p>
          Apuntes y materiales organizados alrededor de los temas del curso.
        </p>
      </div>
      <div class="cards">
        <a href="/work/#modelado"
          ><span>01 / MODELADO</span><h3>Entidades y relaciones</h3><p>
            Diagramas, claves y transformación al modelo relacional.
          </p><b>Ver evidencias →</b></a
        >
        <a href="/work/#normalizacion"
          ><span>02 / NORMALIZACIÓN</span><h3>Organizar los datos</h3><p>
            Dependencias, formas normales y ejercicios desarrollados.
          </p><b>Ver evidencias →</b></a
        >
        <a href="/work/#sql"
          ><span>03 / SQL</span><h3>Consultar información</h3><p>
            Material de estudio sobre consultas, funciones y joins.
          </p><b>Ver materiales →</b></a
        >
        <a href="/blog/"
          ><span>04 / BLOG</span><h3>Apuntes del curso</h3><p>
            Conceptos y reflexiones para repasar lo aprendido.
          </p><b>Leer apuntes →</b></a
        >
      </div>
    </section>
  </main><Footer />
</BaseLayout>
<style>
  .home {
    width: min(1200px, calc(100% - 2.5rem));
    margin: auto;
  }
  .hero {
    padding: clamp(5rem, 12vw, 10rem) 0 7rem;
    max-width: 1000px;
  }
  .eyebrow {
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
    margin: 2rem 0;
  }
  .hero h1 span {
    color: var(--color-accent);
  }
  .lead {
    max-width: 700px;
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .signature {
    margin-top: 2rem;
    font-weight: 600;
  }
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
  .actions a {
    border: 1px solid var(--glass-border);
    border-radius: 100px;
    padding: 0.9rem 1.4rem;
    text-decoration: none;
    font-weight: 700;
  }
  .actions .primary {
    background: var(--color-accent);
    color: #fff;
  }
  .explore {
    padding: 2rem 0 8rem;
  }
  .heading {
    max-width: 700px;
    margin-bottom: 2.5rem;
  }
  .heading h2 {
    font-size: clamp(2.3rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .heading > p:last-child,
  .cards p {
    color: var(--color-text-muted);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .cards a {
    padding: 2rem;
    min-height: 240px;
    border: 1px solid var(--glass-border);
    border-radius: 1.25rem;
    background: var(--glass-background, rgba(128, 128, 128, 0.06));
    text-decoration: none;
    transition: transform 0.2s;
  }
  .cards a:hover {
    transform: translateY(-4px);
  }
  .cards span {
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }
  .cards h3 {
    font-size: 1.6rem;
    margin: 1.2rem 0 0.5rem;
  }
  .cards b {
    display: block;
    margin-top: 1.5rem;
  }
  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-bottom: 4rem;
    }
  }
</style>
