---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';

const modelResources = [
  {
    name: 'Modelo entidad–relación',
    file: 'modelo-er',
    note: 'Entidades, atributos, relaciones y cardinalidad.',
  },
  {
    name: 'Modelo relacional',
    file: 'modelo-relacional',
    note: 'Relaciones, claves y restricciones.',
  },
  {
    name: 'Transformación del MER al MR',
    file: 'transformacion-mer-mr',
    note: 'Reglas para llevar el diseño conceptual a tablas.',
  },
  {
    name: 'Relaciones ISA',
    file: 'relaciones-isa',
    note: 'Especialización, totalidad y exclusividad.',
  },
];
const sqlResources = [
  {
    name: 'Ruta de aprendizaje de SQL',
    file: 'sql-roadmap',
    note: 'Panorama de los temas del curso.',
  },
  {
    name: '01 · Introducción',
    file: 'sql-1-introduccion',
    note: 'Conceptos iniciales de bases de datos y SQL.',
  },
  {
    name: '02 · SELECT',
    file: 'sql-2-select',
    note: 'Recuperar columnas y filas de una tabla.',
  },
  {
    name: '03 · Filtros y ordenamiento',
    file: 'sql-3-filtros',
    note: 'Restringir y ordenar resultados.',
  },
  {
    name: '04 · Funciones de una fila',
    file: 'sql-4-funciones',
    note: 'Trabajar con valores individuales.',
  },
  {
    name: '05 · Funciones de conversión',
    file: 'sql-5-conversion',
    note: 'Convertir y manejar tipos de datos.',
  },
  {
    name: '06 · Funciones de grupo',
    file: 'sql-6-agrupacion',
    note: 'Resumir y agrupar conjuntos de filas.',
  },
  {
    name: '07 · Joins',
    file: 'sql-7-joins',
    note: 'Relacionar información de varias tablas.',
  },
];
---

<BaseLayout
  title="Evidencias"
  description="Ejercicios, diagramas y aprendizajes de Bases de Datos 1."
>
  <Header />
  <main id="main" tabindex="-1" class="portfolio">
    <header class="intro">
      <div class="intro-main">
        <p class="kicker">BASES DE DATOS 1 · EVIDENCIAS</p><h1>
          El trabajo detrás <em>del aprendizaje.</em>
        </h1><p class="intro-copy">
          Modelos, talleres y proyectos que muestran cómo las ideas del curso
          toman forma en la práctica.
        </p><a class="intro-start" href="#modelado">Empezar el recorrido ↓</a>
      </div><nav class="evidence-index" aria-label="Categorías de evidencias">
        <p>EN ESTE RECORRIDO</p><a href="#modelado"
          ><span>01</span><strong>Modelado</strong><b>↗</b></a
        ><a href="#normalizacion"
          ><span>02</span><strong>Normalización</strong><b>↗</b></a
        ><a href="#sql"><span>03</span><strong>SQL</strong><b>↗</b></a><a
          href="#proyecto"
          ><span>04</span><strong>Proyecto final y parcial</strong><b>↗</b></a
        >
      </nav>
    </header>
    <div class="evidence-ribbon">
      <span>DISEÑAR</span><i>✦</i><span>TRANSFORMAR</span><i>✦</i><span
        >CONSULTAR</span
      ><i>✦</i><span>APLICAR</span>
    </div>

    <section class="evidence-highlights" aria-labelledby="highlights-title">
      <div class="highlights-heading">
        <div>
          <p class="kicker">UN VISTAZO AL SEMESTRE</p><h2 id="highlights-title">
            Tres momentos, <em>un recorrido.</em>
          </h2>
        </div><p>
          Del ejercicio de clase al trabajo en equipo: selecciona una evidencia
          para conocer su contexto.
        </p>
      </div><div class="highlights-grid">
        <a class="highlight highlight--project" href="#sigevet"
          ><div class="highlight-meta">
            <span>01 / PROYECTO FINAL</span><b>↗</b>
          </div><div class="highlight-image">
            <img
              src="/vistas/sigevet-modelo-relacional.png"
              alt="Vista del modelo relacional del proyecto SIGEVET"
              loading="lazy"
            />
          </div><div class="highlight-copy">
            <small>MODELO · BASE DE DATOS · APLICACIÓN</small><h3>SIGEVET</h3><p
            >
              Un proyecto de gestión veterinaria desarrollado en equipo.
            </p>
          </div></a
        ><a class="highlight highlight--exam" href="#cineandes"
          ><div class="highlight-meta">
            <span>02 / PARCIAL</span><b>↗</b>
          </div><div class="highlight-image">
            <img
              src="/vistas/modelo-cineandes.png"
              alt="Vista del modelo entidad relación CineAndes"
              loading="lazy"
            />
          </div><div class="highlight-copy">
            <small>ENTIDADES · RELACIONES · CLAVES</small><h3>CineAndes</h3><p>
              El modelo entidad–relación de una cadena de cine.
            </p>
          </div></a
        ><a class="highlight highlight--norm" href="#normalizacion"
          ><div class="highlight-meta">
            <span>03 / TALLER</span><b>↗</b>
          </div><div class="highlight-image">
            <img
              src="/vistas/normalizacion-taller-3.png"
              alt="Vista del resumen del taller de normalización"
              loading="lazy"
            />
          </div><div class="highlight-copy">
            <small>DEPENDENCIAS · FORMAS NORMALES</small><h3>
              Normalización
            </h3><p>Dos esquemas analizados paso a paso.</p>
          </div></a>
      </div>
    </section>

    <section class="section" id="modelado">
      <div class="section-header">
        <span>01 / MODELADO</span><div>
          <h2>De una idea a un modelo</h2><p>
            Representar un problema exige decidir qué información importa y cómo
            se conecta.
          </p>
        </div>
      </div>
      <div class="model-gallery">
        <article class="case case--class">
          <div class="case-heading">
            <div>
              <p class="label">
                EJERCICIO EN CLASE · MODELO ENTIDAD–RELACIÓN
              </p><h3>Equipos, jugadores y partidos</h3>
            </div><span class="pill">Diagrama</span>
          </div>
          <div class="case-copy">
            <p>
              <strong>La actividad.</strong> Este ejercicio de clase representa equipos,
              jugadores, partidos y la tabla de posiciones mediante entidades, atributos
              y relaciones.
            </p><p>
              <strong>Lo que me deja.</strong> Dibujar el modelo ayuda a distinguir
              los objetos del problema de las acciones que los relacionan, y a revisar
              cuáles atributos identifican cada entidad.
            </p>
          </div>
          <figure class="visual">
            <a
              href="/archivos/mer-clase.png"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src="/archivos/mer-clase.png"
                alt="Diagrama entidad relación del ejercicio de equipos, jugadores y partidos"
                loading="lazy"
              /></a
            ><figcaption>
              Ejercicio de clase · pulsa la imagen para ampliarla ↗
            </figcaption>
          </figure>
          <div class="links">
            <a href="/blog/modelo-entidad-relacion/"
              >Entender el modelo entidad–relación →</a
            ><a href="/blog/cardinalidad-participacion/"
              >Repasar cardinalidad →</a
            >
          </div>
        </article>
        <article class="case" id="biblioteca">
          <div class="case-heading">
            <div>
              <p class="label">REVISIÓN DE UN MODELO · BIBLIOTECA</p><h3>
                Libros y relaciones
              </h3>
            </div><span class="pill">Diagrama</span>
          </div>
          <div class="case-copy">
            <p>
              <strong>La actividad.</strong> El diagrama relaciona libros, autores,
              editores, clientes, cesta de compra y almacén. En mis apuntes registré
              propuestas para revisar las claves y renombrar las relaciones.
            </p><p>
              <strong>Lo que me deja.</strong> Una clave debe identificar la entidad
              de forma adecuada y el nombre de cada relación debe ayudar a leer qué
              sucede entre sus participantes.
            </p>
          </div>
          <figure class="visual">
            <a
              href="/vistas/modelo-biblioteca.png"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src="/vistas/modelo-biblioteca.png"
                alt="Vista previa del modelo entidad relación de biblioteca"
                loading="lazy"
              /></a
            ><figcaption>
              Versión conservada del diagrama · pulsa para ampliar ↗
            </figcaption>
          </figure>
          <div class="note">
            <strong>Sobre esta versión.</strong> El dibujo conserva las claves y nombres
            originales. Mis apuntes proponen agregar cédula como clave para autor,
            editor y cliente, y ajustar algunos verbos; esas propuestas no están incorporadas
            en esta imagen.
          </div>
          <div class="links">
            <a href="/blog/atributos-mer/">Repasar atributos y claves →</a><a
              href="/vistas/modelo-biblioteca.png">Abrir imagen PNG ↗</a
            ><a href="/archivos/modelo-biblioteca.drawio"
              >Archivo editable .drawio ↓</a
            >
          </div>
        </article>
      </div>
      <article class="case case--workshop">
        <div class="case-heading">
          <div>
            <p class="label">TALLER EN GRUPO · TERMINAL PORTUARIA</p><h3>
              Transformar el modelo en tablas
            </h3>
          </div><span class="pill">Taller 1</span>
        </div>
        <div class="case-copy">
          <p>
            <strong>La actividad.</strong> Con Juan David Polo y Miguel Ramos desarrollamos
            un taller de reglas de transformación sobre la terminal portuaria Bahía
            Verde. Analizamos atributos, relaciones N:M, relaciones ternarias y agregación.
          </p><p>
            <strong>Lo que me deja.</strong> La clave de una entidad débil incorpora
            la identificación de su propietaria. En una relación N:M, los datos que
            describen la relación pertenecen a la tabla que la representa.
          </p>
        </div>
        <div class="diagram-strip" aria-label="Ejemplo del taller">
          <div>
            <small>ATRIBUTO COMPUESTO</small><strong>nombre completo</strong
            ><span>se descompone en nombres y apellidos</span>
          </div><div>
            <small>ATRIBUTO MULTIVALUADO</small><strong>correos</strong><span
              >se representan por separado</span
            >
          </div><div>
            <small>RELACIÓN N:M</small><strong>embarque</strong><span
              >reúne las claves y sus propios datos</span
            >
          </div>
        </div>
        <div class="links">
          <a href="/archivos/taller-transformacion.docx"
            >Ver trabajo del grupo ↓</a
          ><a href="/archivos/solucion-guiada.pdf"
            >Consultar solución guiada ↗</a
          ><a href="/blog/transformacion-modelo-relacional/">Leer reflexión →</a
          >
        </div>
      </article>
      <details class="support">
        <summary
          >Ver diapositivas de apoyo de modelado <span>4 presentaciones +</span
          ></summary
        ><p>
          Material de clase para repasar los conceptos; las imágenes son vistas
          previas de las presentaciones.
        </p><div class="resources">
          {
            modelResources.map((r) => (
              <article class="resource">
                <>
                  <a
                    class="resource-image"
                    href={'/vistas/' + r.file + '-1.png'}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={'/vistas/' + r.file + '-1.png'}
                      alt={'Primera diapositiva: ' + r.name}
                      loading="lazy"
                    />
                  </a>
                  <div class="resource-body">
                    <>
                      <p class="label">MATERIAL DE CLASE</p>
                      <h4>{r.name}</h4>
                      <p>{r.note}</p>
                      <details class="slides">
                        <>
                          <summary>Ver más diapositivas</summary>
                          <div class="slide-grid">
                            {[2, 3].map((i) => (
                              <a
                                href={'/vistas/' + r.file + '-' + i + '.png'}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                <img
                                  src={'/vistas/' + r.file + '-' + i + '.png'}
                                  alt={r.name + ', diapositiva ' + i}
                                  loading="lazy"
                                />
                              </a>
                            ))}
                          </div>
                        </>
                      </details>
                      <a
                        class="download"
                        href={'/archivos/' + r.file + '.pptx'}
                      >
                        Presentación completa ↓
                      </a>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </details>
    </section>

    <section class="section" id="normalizacion">
      <div class="section-header">
        <span>02 / NORMALIZACIÓN</span><div>
          <h2>Ordenar para cuidar los datos</h2><p>
            Un ejercicio de análisis de dependencias y separación de información
            en tablas.
          </p>
        </div>
      </div>
      <article class="case case--normalization">
        <div class="case-heading">
          <div>
            <p class="label">TALLER EN GRUPO · DEPENDENCIAS FUNCIONALES</p><h3>
              Hospitalización y pedidos
            </h3>
          </div><span class="pill">Excel + análisis</span>
        </div>
        <div class="case-copy">
          <p>
            <strong>La actividad.</strong> En el taller analizamos dos esquemas: hospitalización
            y pedido–cliente–producto. Identificamos sus claves, dependencias y posibles
            anomalías, y desarrollamos la normalización paso a paso.
          </p><p>
            <strong>Lo que me deja.</strong> Si los datos de un médico o de un cliente
            se repiten en muchas filas, una actualización puede producir inconsistencias.
            Separar las tablas según sus dependencias ayuda a reducir ese problema.
          </p>
        </div>
        <div class="comparison">
          <div>
            <span>ESQUEMA 01</span><h4>Hospitalización</h4><p>
              Se identificaron dependencias transitivas asociadas al médico y a
              la cama. Bajo los supuestos del ejercicio, se separaron
              hospitalización, médico y cama.
            </p>
          </div><div>
            <span>ESQUEMA 02</span><h4>Pedidos</h4><p>
              La clave compuesta permitió identificar dependencias parciales y
              transitivas. El resultado distingue cliente, vendedor, producto,
              pedido y detalle.
            </p>
          </div>
        </div>
        <figure class="visual">
          <a
            href="/vistas/normalizacion-taller-3.png"
            target="_blank"
            rel="noopener noreferrer"
            ><img
              src="/vistas/normalizacion-taller-3.png"
              alt="Resumen comparativo de los esquemas del taller de normalización"
              loading="lazy"
            /></a
          ><figcaption>
            Resumen comparativo del archivo del grupo · pulsa para ampliar ↗
          </figcaption>
        </figure>
        <details class="inline-details">
          <summary>Ver el desarrollo paso a paso</summary><div
            class="sheet-grid"
          >
            {
              [1, 2].map((i) => (
                <a
                  href={'/vistas/normalizacion-taller-' + i + '.png'}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <>
                    <img
                      src={'/vistas/normalizacion-taller-' + i + '.png'}
                      alt={'Vista de la hoja del esquema ' + i + ' del taller'}
                      loading="lazy"
                    />
                    <span>Ampliar esquema {i} ↗</span>
                  </>
                </a>
              ))
            }
          </div>
        </details>
        <div class="links">
          <a href="/archivos/normalizacion-paso-a-paso.xlsx"
            >Abrir el taller en Excel ↓</a
          ><a href="/archivos/preguntas-normalizacion.docx"
            >Respuestas del grupo ↓</a
          ><a href="/archivos/resultados-normalizacion.xlsx"
            >Otros ejercicios de normalización ↓</a
          ><a href="/blog/normalizacion/">Leer reflexión →</a>
        </div>
      </article>
      <details class="support">
        <summary
          >Ver diapositivas de normalización <span>Material de clase +</span
          ></summary
        ><div class="slide-grid slide-grid--large">
          {
            [1, 2, 3].map((i) => (
              <a
                href={'/vistas/normalizacion-' + i + '.png'}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src={'/vistas/normalizacion-' + i + '.png'}
                  alt={'Normalización, diapositiva ' + i}
                  loading="lazy"
                />
              </a>
            ))
          }
        </div><a class="download" href="/archivos/normalizacion.pptx"
          >Presentación completa ↓</a
        >
      </details>
    </section>

    <section class="section" id="sql">
      <div class="section-header">
        <span>03 / SQL</span><div>
          <h2>Preguntar a los datos</h2><p>
            Los materiales recorren la consulta de información, desde la
            selección de filas hasta la combinación de tablas.
          </p>
        </div>
      </div>
      <article class="case sql-intro">
        <div class="case-heading">
          <div>
            <p class="label">APUNTES Y MATERIAL DE CLASE</p><h3>
              Una ruta para consultar
            </h3>
          </div><span class="pill">SQL</span>
        </div><div class="case-copy">
          <p>
            <strong>El recorrido.</strong> El material presenta SELECT, filtros, ordenamiento,
            funciones, agrupación y joins. Las vistas siguientes corresponden a diapositivas
            de clase.
          </p><p>
            <strong>Lo que me deja.</strong> Antes de escribir una consulta conviene
            identificar qué información se necesita, qué condiciones debe cumplir
            y qué tablas hay que relacionar.
          </p>
        </div><div class="links">
          <a href="/blog/sql/">Leer apuntes de SQL →</a>
        </div>
      </article>
      <div class="resources">
        {
          sqlResources.map((r) => (
            <article class="resource">
              <>
                <a
                  class="resource-image"
                  href={'/vistas/' + r.file + '-2.png'}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src={'/vistas/' + r.file + '-2.png'}
                    alt={'Vista previa de ' + r.name}
                    loading="lazy"
                  />
                </a>
                <div class="resource-body">
                  <>
                    <p class="label">DIAPOSITIVAS DE CLASE</p>
                    <h3>{r.name}</h3>
                    <p>{r.note}</p>
                    <details class="slides">
                      <>
                        <summary>Ver vistas previas</summary>
                        <div class="slide-grid">
                          {[1, 3].map((i) => (
                            <a
                              href={'/vistas/' + r.file + '-' + i + '.png'}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              <img
                                src={'/vistas/' + r.file + '-' + i + '.png'}
                                alt={r.name + ', diapositiva ' + i}
                                loading="lazy"
                              />
                            </a>
                          ))}
                        </div>
                      </>
                    </details>
                    <a class="download" href={'/archivos/' + r.file + '.pptx'}>
                      Presentación completa ↓
                    </a>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="proyecto">
      <div class="section-header">
        <span>04 / PROYECTO</span><div>
          <h2>Del parcial al proyecto final</h2><p>
            Dos evidencias que conectan el diseño de modelos con la aplicación
            de las bases de datos.
          </p>
        </div>
      </div>
      <article class="case project-case" id="sigevet">
        <div class="case-heading">
          <div>
            <p class="label">PROYECTO FINAL · TRABAJO EN EQUIPO</p><h3>
              SIGEVET: gestión veterinaria
            </h3>
          </div><span class="pill">Proyecto final</span>
        </div>
        <div class="project-summary">
          <p>
            Un sistema para una red de clínicas veterinarias que conecta el
            diseño de la base de datos con una aplicación web.
          </p><div class="project-tags">
            <span>MODELADO DE DATOS</span><span>MYSQL</span><span>JAVA</span
            ><span>ANGULAR</span>
          </div>
        </div>
        <div class="case-copy">
          <p>
            <strong>La actividad.</strong> SIGEVET representa una red ficticia de
            clínicas: clientes, mascotas, historias clínicas, citas, consultas, inventario
            y facturación. Mi rol en el equipo fue de analista y modelador de datos,
            según la documentación del proyecto.
          </p><p>
            <strong>Lo que me deja.</strong> El proyecto reúne el modelo entidad–relación,
            la transformación a tablas, la normalización y las consultas. La base
            en MySQL se conecta con una API en Java y una interfaz en Angular.
          </p>
        </div>
        <div class="project-path" aria-label="Etapas del proyecto SIGEVET">
          <div>
            <span>01 / DISEÑO</span><strong>Entender el caso</strong><p>
              Entidades, relaciones y reglas de negocio para las clínicas.
            </p>
          </div><div>
            <span>02 / ESTRUCTURA</span><strong>Organizar los datos</strong><p>
              Tablas relacionadas, claves y normalización en MySQL.
            </p>
          </div><div>
            <span>03 / APLICACIÓN</span><strong>Consultar y gestionar</strong><p
            >
              Una API y una interfaz web conectadas a la base de datos.
            </p>
          </div>
        </div>
        <figure class="visual">
          <a
            href="/vistas/sigevet-modelo-er.png"
            target="_blank"
            rel="noopener noreferrer"
            ><img
              src="/vistas/sigevet-modelo-er.png"
              alt="Modelo entidad–relación global del proyecto SIGEVET"
              loading="lazy"
            /></a
          ><figcaption>
            SIGEVET · modelo entidad–relación global en notación Chen · pulsa
            para ampliar ↗
          </figcaption>
        </figure>
        <details class="inline-details">
          <summary>Ver el modelo relacional del proyecto</summary><figure
            class="visual sigevet-relational"
          >
            <a
              href="/vistas/sigevet-modelo-relacional.png"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src="/vistas/sigevet-modelo-relacional.png"
                alt="Modelo relacional global de SIGEVET"
                loading="lazy"
              /></a
            ><figcaption>
              Modelo relacional global · pulsa para ampliar ↗
            </figcaption>
          </figure>
        </details>
        <div class="links">
          <a
            href="https://github.com/Estarlan/proyecto-bd1-sigevet"
            target="_blank"
            rel="noopener noreferrer">Ver repositorio del proyecto ↗</a
          ><a
            href="https://github.com/Estarlan/proyecto-bd1-sigevet/tree/main/documentos/fase1/diagramas_drawio"
            target="_blank"
            rel="noopener noreferrer">Explorar los modelos ↗</a
          ><a href="/blog/sigevet/">Leer sobre el proyecto →</a>
        </div>
      </article>
      <article class="case case--exam" id="cineandes">
        <div class="case-heading">
          <div>
            <p class="label">
              PARCIAL 1 · MODELO ENTIDAD–RELACIÓN · CINEANDES
            </p><h3>CineAndes: modelo del parcial</h3>
          </div><span class="pill">Parcial 1</span>
        </div>
        <div class="case-copy">
          <p>
