---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import PostGrid from '@/components/blog/PostGrid.astro';
import { getPublishedPosts } from '@/lib/posts';

const allPosts = await getPublishedPosts();
const sections = [
  {
    id: 'fundamentos',
    label: '01 / Fundamentos',
    title: 'Entender los datos',
    description: 'Bases de datos, gestores y niveles de diseño.',
    tags: ['Fundamentos'],
  },
  {
    id: 'modelado',
    label: '02 / Modelado',
    title: 'Representar el problema',
    description: 'Entidades, relaciones, cardinalidad y transformación.',
    tags: ['Modelado', 'Modelo relacional'],
  },
  {
    id: 'relacional',
    label: '03 / Modelo relacional',
    title: 'Organizar y razonar',
    description: 'Claves, dependencias, normalización y álgebra relacional.',
    tags: ['Relacional', 'Normalización'],
  },
  {
    id: 'sql',
    label: '04 / SQL',
    title: 'Consultar la información',
    description: 'Consultas, funciones, agrupaciones y combinaciones.',
    tags: ['SQL'],
  },
];
const assigned = new Set<string>();
const groups = sections.map((section) => {
  const posts = allPosts.filter((post) => {
    if (assigned.has(post.id)) return false;
    if (!post.data.tags.some((tag) => section.tags.includes(tag))) return false;
    assigned.add(post.id);
    return true;
  });
  return { ...section, posts };
});
---

<BaseLayout title="Blog" description="Apuntes de estudio de Bases de Datos 1."
  ><Header />
  <main id="main" tabindex="-1" class="journal">
    <header class="journal-hero">
      <p class="eyebrow">BASES DE DATOS 1 · CUADERNO DE ESTUDIO</p><h1>
        Ideas para <span>conectar los datos.</span>
      </h1><p>
        Conceptos, ejemplos y apuntes organizados para repasar los temas del
        curso.
      </p><nav aria-label="Temas del blog">
        {
          groups.map((g) => (
            <a href={'#' + g.id}>{g.label.split(' / ')[1]} ↓</a>
          ))
        }
      </nav>
    </header>
    {
      groups.map((g) => (
        <section class="journal-section" id={g.id}>
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <p class="eyebrow">{g.label}</p>
                    <h2>{g.title}</h2>
                    <p>{g.description}</p>
                  </>
                </div>
                <span>{g.posts.length} entradas</span>
              </>
            </div>
            <PostGrid posts={g.posts} />
          </>
        </section>
      ))
    }
    <div class="endnote">
      <p>
        Los ejemplos de las entradas son ilustrativos. Las actividades y
        archivos del semestre están reunidos por separado.
      </p><a href="/work/">Explorar evidencias →</a>
    </div>
  </main><Footer />
</BaseLayout>
<style>
  .journal {
    width: min(1200px, calc(100% - 2.5rem));
    margin: auto;
  }
  .journal-hero {
    padding: clamp(5rem, 10vw, 9rem) 0 5rem;
    max-width: 1000px;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    color: var(--color-accent);
    font-weight: 800;
    text-transform: uppercase;
  }
  .journal-hero h1 {
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.97;
    letter-spacing: -0.065em;
    margin: 1.6rem 0;
  }
  .journal-hero h1 span {
    color: var(--color-accent);
  }
  .journal-hero > p:not(.eyebrow) {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 650px;
  }
  .journal-hero nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .journal-hero nav a {
    border: 1px solid var(--glass-border);
    border-radius: 100px;
    padding: 0.65rem 1rem;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .journal-section {
    scroll-margin-top: 6rem;
    padding: 4rem 0;
    border-top: 1px solid var(--glass-border);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin: 0.6rem 0;
  }
  .section-heading p:not(.eyebrow),
  .section-heading span,
  .endnote p {
    color: var(--color-text-muted);
  }
  .section-heading span {
    white-space: nowrap;
    font-size: 0.85rem;
  }
  .endnote {
    padding: 2rem 0 7rem;
  }
  .endnote a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .section-heading {
      display: block;
    }
    .journal-section {
      padding: 3rem 0;
    }
    .journal-hero {
      padding-top: 4rem;
    }
  }
</style>
